{
  // MiyeeFit Pro: Cloudflare Worker (static app + cloud account API)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyeefitness",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // No "id": Wrangler creates the KV namespace automatically on the first deploy.
  "kv_namespaces": [
    { "binding": "MIYEEFIT_KV" }
  ],
  "observability": { "enabled": true }
}
